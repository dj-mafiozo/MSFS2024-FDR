 Function IsPMDGNG3Aircraft(Const Title : String) : Boolean;

Implementation

 Uses
  System.SysUtils;

 Function IsPMDGNG3Aircraft(Const Title : String) : Boolean;
  Var
   T : String;
  Begin
   T      := UpperCase(Title).Replace('-', '').Replace('_', '').Replace(' ', '');
   Result := (Pos('PMDG', T) > 0) And ((Pos('737', T) > 0) Or (Pos('B736', T) > 0) Or (Pos('B737', T) > 0) Or (Pos('B738', T) > 0) Or (Pos('B739', T) > 0)) And (Pos('MAX', T) = 0);
  End;

End.
