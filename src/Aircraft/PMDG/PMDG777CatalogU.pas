 Function IsPMDG777Aircraft(Const Title : String) : Boolean;

Implementation

 Uses
  System.SysUtils;

 Function IsPMDG777Aircraft(Const Title : String) : Boolean;
  Var
   t : String;
  Begin
   t      := UpperCase(Title).Replace('-', '').Replace('_', '').Replace(' ', '');
   Result := (Pos('PMDG', t) > 0) And ((Pos('777', t) > 0) Or (Pos('B77', t) > 0)) And (Pos('MAX', t) = 0);
  End;

End.
