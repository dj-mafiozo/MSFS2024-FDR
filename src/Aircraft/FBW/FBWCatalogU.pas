Function IsFBWAircraft(Const Title : String) : Boolean;

Implementation

 Uses
  System.SysUtils;

 Function IsFBWAircraft(Const Title : String) : Boolean;
  Var
   T : String;
  Begin
   T      := UpperCase(Title).Replace('-', '').Replace('_', '').Replace(' ', '');
   Result := (Pos('A32NX', T) > 0) Or ((Pos('FLYBYWIRE', T) > 0) And (Pos('A320', T) > 0)) Or ((Pos('FBW', T) > 0) And (Pos('A320', T) > 0));
  End;

End.
