 Function IsFenixAircraft(Const Title : String) : Boolean;

Implementation

 Uses
  System.SysUtils;

 Function IsFenixAircraft(Const Title : String) : Boolean;
  Var
   T : String;
  Begin
   T      := UpperCase(Title);
   Result := (Pos('FENIX', T) > 0) Or (Pos('FNX_32', T) > 0) Or (Pos('FNX A32', T) > 0);
  End;

End.
