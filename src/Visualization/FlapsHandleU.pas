      ExpectedPositions := 6;
     End;
    faS17 :
     DisplayValue := ''; // unverified
    faS55 :
     DisplayValue := ''; // unverified
    faS64 :
     DisplayValue := ''; // no_wing_flaps
    faSC7 :
     DisplayValue := ''; // unverified
    faSEST :
     DisplayValue := ''; // unverified
    faSF34 :
     DisplayValue := ''; // unverified
    faSF50 :
     Begin
      DisplayValue      := '0=UP\r\n1=50%\r\n2=100%';
      ExpectedPositions := 3;
     End;
    faSHIP :
     DisplayValue := ''; // no_wing_flaps
    faSR22 :
     Begin
      DisplayValue      := '0=UP\r\n1=50%\r\n2=100%';
      ExpectedPositions := 3;
     End;
    faT6 :
     DisplayValue := ''; // unverified
    faTAUR :
     DisplayValue := ''; // unverified
    faTBM9 :
     Begin
      DisplayValue      := '0=UP\r\n1=TO\r\n2=LDG';
      ExpectedPositions := 3;
     End;
    faUHEL :
     DisplayValue := ''; // no_wing_flaps
    faULAC :
     Begin
      If (Pos('HAWK ARROW', Title) > 0) Or (Pos('CGS HAWK', Title) > 0) Then
       Begin
        DisplayValue      := '0=UP\r\n1=10';
        ExpectedPositions := 2;
       End;
     End;
    faVL3 :
     DisplayValue := ''; // unverified
    faWILG :
     Begin
      If (Pos('DRACO', Title) > 0) Then
       Begin
        DisplayValue      := '0=UP\r\n1=11\r\n2=22\r\n3=33\r\n4=44';
        ExpectedPositions := 5;
       End;
     End;
    faWSCO :
     DisplayValue := ''; // unverified
    faZLIN :
     DisplayValue := ''; // unverified
    faZZZZ :
     DisplayValue := ''; // unverified
   Else
     DisplayValue := '';
   End;
   // Recorded model configuration wins over an ICAO reference profile.
   If (HandlePositionCount > 0) And (ExpectedPositions > 0) And (HandlePositionCount <> ExpectedPositions) Then
    DisplayValue := '';
   Result        := DisplayValue;
  End;

 Function RecordedFlapPositionCount(Labels : TStrings; Const Values : TArray<Double>) : Integer;
  Var
   i : Integer;
   v : Double;
  Begin
   Result := 0;
   If Labels = Nil Then
    Exit;
   i := Labels.IndexOf('flaps_num_handle_positions');
   If (i < 0) Or (i >= Length(Values)) Then
    Exit;
   v := Values[i];
   If IsNan(v) Or IsInfinite(v) Then
    Exit;
   If (v >= 1) And (v <= 256) Then
    If v = Trunc(v) Then
     Result := Trunc(v);
  End;

End.
