+program ExportTests;
+{$APPTYPE CONSOLE}
+uses System.SysUtils, System.Classes, AircraftTypes, ScreenModel, FlightPadScreenIPC;
+var P: TAircraftProfile; Model: TScreenModel; Lines: TStringList; Text: string; I: Integer;
+procedure Check(B: Boolean; const Message: string);
+begin if not B then raise Exception.Create(Message); end;
+begin
+ for I:=0 to 1 do
+ begin
+  P:=Default(TAircraftProfile); P.Airbus:=True; P.Fenix:=I=0;
+  Model:=TScreenModel.Create(P); Lines:=TStringList.Create;
+  try
+   Check(not Model.HasScreen,'No initial fake screen');
+   Model.Parse('{"type":"exec_led","value":true}');
+   Check(not Model.HasScreen,'LED is not a screen');
+   Model.Parse('{"left":{"title":"PERF TAKE OFF","titleLeft":"TEST","page":"1/2","lines":[["V1","135"],["VR","140"],["V2","145"]],"scratchpad":"ABC"}}');
+   Check(Model.HasScreen,'Parsed full screen available');
+   Text:=Model.ExportText; Check(Length(Text)=FlightPadTextLength,'Fixed export length');
+   Lines.Text:=Text; Check(Lines.Count=14,'Fourteen rows');
+   Check(Lines[1]='V1                   135','Left/right layout');
+   Check(Lines[13]='ABC                     ','Scratchpad and trailing spaces');
+   Check(Pos('1/2',Lines[0])>0,'Page number');
+   Model.Reset;Check(not Model.HasScreen,'Reset invalidates availability');
+  finally Lines.Free;Model.Free;end;
+ end;
+ Writeln('PASS: Fenix/FBW model text export, complete 14x24 screen, alignment, scratchpad, CRLF and reset availability.');
+end.
