+unit FlightPadScreenIPC;
+
+interface
+
+uses Winapi.Windows, System.SysUtils;
+
+const
+  FlightPadTextLength = 14 * 26; // 24 UTF-16 cells + CRLF per row
+  FlightPadHeartbeatMS = 5000;
+
+type
+  // Fixed layout, shared unchanged between Win32 FlightPad and Win64 FDR.
+  TFlightPadScreenPacket = packed record
+    Magic, Version, PacketSize, ProcessID: Cardinal;
+    HeartbeatTick, ScreenTick: UInt64;
+    ScreenUTC: TFileTime;
+    Available, TextLength: Cardinal;
+    Text: array[0..FlightPadTextLength-1] of WideChar;
+  end;
+  TFlightPadScreenSnapshot = record
+    Text: string;
+    ProcessID: Cardinal;
+    ScreenTick: UInt64;
+    ScreenUTC: TFileTime;
+  end;
+  TFlightPadScreenPublisher = class
+  private
+    FMap, FMutex: THandle;
+    FView: Pointer;
+    FLastText: string;
+    FLastAvailable: Boolean;
+    FScreenTick: UInt64;
+    FScreenUTC: TFileTime;
+  public
+    constructor Create(const Profile: string);
+    destructor Destroy; override;
+    procedure Publish(const Text: string; Available: Boolean);
+  end;
+
+function ReadFlightPadScreen(const Profile: string; out Snapshot: TFlightPadScreenSnapshot): Boolean;
+function ReadFlightPadScreenPID(const Profile: string; PID: Cardinal;
+  out Snapshot: TFlightPadScreenSnapshot): Boolean;
+
+implementation
+
+uses Winapi.TlHelp32;
+
+const ScreenMagic = $46504D43;
+
+function ObjectName(const Profile: string; PID: Cardinal): string;
+begin
+  Result := 'Local\FlightPadFMC.Screen.v1.' + Profile + '.' + IntToStr(PID);
+end;
+
+constructor TFlightPadScreenPublisher.Create(const Profile: string);
+var Name: string;
+begin
+  inherited Create;
+  if (Profile <> 'FenixA320') and (Profile <> 'FBWA320') then Exit;
+  Name := ObjectName(Profile, GetCurrentProcessId);
+  FMutex := CreateMutex(nil, False, PChar(Name + '.Lock'));
+  if FMutex = 0 then Exit;
+  FMap := CreateFileMapping(INVALID_HANDLE_VALUE, nil, PAGE_READWRITE, 0,
+    SizeOf(TFlightPadScreenPacket), PChar(Name));
+  if FMap = 0 then Exit;
+  FView := MapViewOfFile(FMap, FILE_MAP_WRITE, 0, 0, SizeOf(TFlightPadScreenPacket));
+end;
+
+destructor TFlightPadScreenPublisher.Destroy;
+begin
+  Publish('', False);
+  if FView <> nil then UnmapViewOfFile(FView);
+  if FMap <> 0 then CloseHandle(FMap);
+  if FMutex <> 0 then CloseHandle(FMutex);
+  inherited;
+end;
+
+procedure TFlightPadScreenPublisher.Publish(const Text: string; Available: Boolean);
+var P: TFlightPadScreenPacket; W: DWORD;
+begin
+  if (FView = nil) or (FMutex = 0) then Exit;
+  Available := Available and (Length(Text) = FlightPadTextLength);
+  W := WaitForSingleObject(FMutex, 0);
+  if (W <> WAIT_OBJECT_0) and (W <> WAIT_ABANDONED) then Exit;
+  try
+    if (Text <> FLastText) or (Available <> FLastAvailable) or (FScreenTick = 0) then
+    begin
+      FScreenTick := GetTickCount64;
+      GetSystemTimeAsFileTime(FScreenUTC);
+      FLastText := Text;
+      FLastAvailable := Available;
+    end;
+    FillChar(P, SizeOf(P), 0);
+    P.Magic := ScreenMagic; P.Version := 1; P.PacketSize := SizeOf(P);
+    P.ProcessID := GetCurrentProcessId;
+    P.HeartbeatTick := GetTickCount64; P.ScreenTick := FScreenTick;
+    P.ScreenUTC := FScreenUTC;
+    if Available then
+    begin
+      P.Available := 1; P.TextLength := Length(Text);
+      Move(PChar(Text)^, P.Text[0], Length(Text) * SizeOf(WideChar));
+    end;
+    Move(P, FView^, SizeOf(P));
+  finally ReleaseMutex(FMutex); end;
+end;
+
+function ReadFlightPadScreenPID(const Profile: string; PID: Cardinal;
+  out Snapshot: TFlightPadScreenSnapshot): Boolean;
+var M, Lock: THandle; View: Pointer; P: TFlightPadScreenPacket;
+  Name: string; W: DWORD; NowTick: UInt64; R: Integer;
+begin
+  Result := False;
+  Snapshot.Text := ''; Snapshot.ProcessID := 0; Snapshot.ScreenTick := 0;
+  FillChar(Snapshot.ScreenUTC, SizeOf(Snapshot.ScreenUTC), 0);
+  Name := ObjectName(Profile, PID);
+  Lock := OpenMutex(SYNCHRONIZE or MUTEX_MODIFY_STATE, False, PChar(Name + '.Lock'));
+  if Lock = 0 then Exit;
+  try
+    M := OpenFileMapping(FILE_MAP_READ, False, PChar(Name));
+    if M = 0 then Exit;
+    try
+      View := MapViewOfFile(M, FILE_MAP_READ, 0, 0, SizeOf(P));
+      if View = nil then Exit;
+      try
+        W := WaitForSingleObject(Lock, 0);
+        if (W <> WAIT_OBJECT_0) and (W <> WAIT_ABANDONED) then Exit;
+        try Move(View^, P, SizeOf(P)); finally ReleaseMutex(Lock); end;
+      finally UnmapViewOfFile(View); end;
+    finally CloseHandle(M); end;
+  finally CloseHandle(Lock); end;
+  NowTick := GetTickCount64;
+  if (P.Magic <> ScreenMagic) or (P.Version <> 1) or (P.PacketSize <> SizeOf(P)) or
+    (P.ProcessID <> PID) or (P.Available <> 1) or (P.TextLength <> FlightPadTextLength) or
+    (P.HeartbeatTick > NowTick) or (NowTick - P.HeartbeatTick > FlightPadHeartbeatMS) then Exit;
+  for R := 0 to 13 do
+    if (P.Text[R*26+24] <> #13) or (P.Text[R*26+25] <> #10) then Exit;
+  SetString(Snapshot.Text, PWideChar(@P.Text[0]), P.TextLength);
+  if Pos(#0, Snapshot.Text) > 0 then begin Snapshot.Text := ''; Exit; end;
+  Snapshot.ProcessID := PID; Snapshot.ScreenTick := P.ScreenTick; Snapshot.ScreenUTC := P.ScreenUTC;
+  Result := True;
+end;
+
+function ReadFlightPadScreen(const Profile: string; out Snapshot: TFlightPadScreenSnapshot): Boolean;
+var Processes: THandle; Entry: TProcessEntry32; Candidate: TFlightPadScreenSnapshot;
+begin
+  Result := False; Snapshot.Text := ''; Snapshot.ProcessID := 0; Snapshot.ScreenTick := 0;
+  FillChar(Snapshot.ScreenUTC, SizeOf(Snapshot.ScreenUTC), 0);
+  Processes := CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
+  if Processes = INVALID_HANDLE_VALUE then Exit;
+  try
+    Entry.dwSize := SizeOf(Entry);
+    if Process32First(Processes, Entry) then
+      repeat
+        if ReadFlightPadScreenPID(Profile, Entry.th32ProcessID, Candidate) then
+          if not Result or (Candidate.ScreenTick > Snapshot.ScreenTick) then
+          begin Snapshot := Candidate; Result := True; end;
+      until not Process32Next(Processes, Entry);
+  finally CloseHandle(Processes); end;
+end;
+
+end.
