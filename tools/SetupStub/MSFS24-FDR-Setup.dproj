<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{6682FA40-8F7B-4D78-B5B7-BC09A2F16071}</ProjectGuid>
    <MainSource>MSFS24-FDR-Setup.dpr</MainSource>
    <ProjectVersion>18.4</ProjectVersion>
    <Base>True</Base>
    <Config Condition="'$(Config)'==''">Release</Config>
    <Platform>Win64</Platform>
    <AppType>Application</AppType>
    <FrameworkType>VCL</FrameworkType>
    <DCC_Namespace>System;System.Win;Winapi;Vcl</DCC_Namespace>
    <DCC_ExeOutput>..\..\bin</DCC_ExeOutput>
    <DCC_DcuOutput>..\..\.build\SetupStub</DCC_DcuOutput>
    <DCC_ObjPath>..\..\.build\SetupStub</DCC_ObjPath>
    <DCC_ResourcePath>..\..\.build\SetupStub;$(DCC_ResourcePath)</DCC_ResourcePath>
    <Platform Condition="'$(Platform)'==''">Win64</Platform>
    <TargetedPlatforms>2</TargetedPlatforms>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Base' or '$(Base)'!=''">
    <Base>true</Base>
  </PropertyGroup>
  <PropertyGroup Condition="('$(Platform)'=='Win64' and '$(Base)'=='true') or '$(Base_Win64)'!=''">
    <Base_Win64>true</Base_Win64>
    <CfgParent>Base</CfgParent>
    <Base>true</Base>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Release' or '$(Cfg_1)'!=''">
    <Cfg_1>true</Cfg_1>
    <CfgParent>Base</CfgParent>
    <Base>true</Base>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Debug' or '$(Cfg_2)'!=''">
    <Cfg_2>true</Cfg_2>
    <CfgParent>Base</CfgParent>
    <Base>true</Base>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Base)'!=''">
    <SanitizedProjectName>MSFS24-FDR-Setup</SanitizedProjectName>
    <VerInfo_IncludeVerInfo>true</VerInfo_IncludeVerInfo>
    <VerInfo_Locale>1045</VerInfo_Locale>
    <VerInfo_MajorVer>0</VerInfo_MajorVer>
    <VerInfo_MinorVer>1</VerInfo_MinorVer>
    <VerInfo_Release>1</VerInfo_Release>
    <VerInfo_Build>72</VerInfo_Build>
    <VerInfo_Keys>CompanyName=DJ M@fi0z0™;FileDescription=MSFS24-FDR Setup placeholder;FileVersion=0.1.1.72;InternalName=MSFS24-FDR-Setup;LegalCopyright=© 2026 DJ M@fi0z0™ ;LegalTrademarks=DJ M@fi0z0™;OriginalFilename=MSFS24-FDR-Setup.exe;ProductName=Microsoft Flight Simulator 2024 - Flight Data Recorder;ProductVersion=0.1;Comments=;CFBundleName=</VerInfo_Keys>
    <Manifest_File>$(BDS)\bin\default_app.manifest</Manifest_File>
    <Icon_MainIcon>..\..\src\MSFS2024-FDR.ico</Icon_MainIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Base_Win64)'!=''">
    <BT_BuildType>Debug</BT_BuildType>
  </PropertyGroup>
  <ItemGroup>
