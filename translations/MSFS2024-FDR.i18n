    <Literal ID="AB9E8B528BE05CF6959BF571963739B5">
      <Value>MSFS2024-FDR - rejestrator lotow Delphi VCL. Pierwotnie oparty na projekcie Qt, od tego czasu znaczaco przebudowany i rozbudowany.</Value>
      <Translation Locale="pl-PL">MSFS2024-FDR - rejestrator lotow Delphi VCL. Pierwotnie oparty na projekcie Qt, od tego czasu znaczaco przebudowany i rozbudowany.</Translation>
      <Translation Locale="en-US">MSFS2024-FDR - Delphi VCL flight recorder. Initially based on the Qt project; extensively rebuilt and expanded since then.</Translation>
      <Translation Locale="de-DE">MSFS2024-FDR - Flugrekorder mit Delphi VCL. Ursprünglich auf dem Qt-Projekt basierend, seitdem umfassend überarbeitet und erweitert.</Translation>
      <Translation Locale="es-ES">MSFS2024-FDR - grabador de vuelos Delphi VCL. Basado inicialmente en el proyecto Qt; ampliamente rediseñado y ampliado desde entonces.</Translation>
    </Literal>
    <Literal ID="D556EEAF79EAFD3368E020F4BFACA964">
      <Value>Shift + klik: nowy raport po polsku</Value>
      <Translation Locale="pl-PL">Shift + klik: nowy raport po polsku</Translation>
      <Translation Locale="en-US">Shift+click: generate a new report in Polish</Translation>
      <Translation Locale="de-DE">Umschalt+Klick: neuen Bericht auf Polnisch erstellen</Translation>
      <Translation Locale="es-ES">Mayús+clic: generar un nuevo informe en polaco</Translation>
    </Literal>
    <Literal ID="AF5B42A59B26EEE9E6C3A1C1DAAC4352">
      <Value>Przeciaganie: przesuwanie czasu. Shift + przeciaganie: zoom zakresu. Ctrl + kolko: zoom. Dwuklik: calosc.</Value>
      <Translation Locale="pl-PL">Przeciaganie: przesuwanie czasu. Shift + przeciaganie: zoom zakresu. Ctrl + kolko: zoom. Dwuklik: calosc.</Translation>
      <Translation Locale="en-US">Drag: pan time. Shift+drag: range zoom. Ctrl+wheel: zoom. Double-click: entire flight.</Translation>
      <Translation Locale="de-DE">Ziehen: Zeitachse verschieben. Umschalt+Ziehen: Bereich vergrößern. Strg+Mausrad: Zoom. Doppelklick: gesamter Flug.</Translation>
      <Translation Locale="es-ES">Arrastrar: desplazar el tiempo. Mayús+arrastrar: ampliar selección. Ctrl+rueda: zoom. Doble clic: vuelo completo.</Translation>
    </Literal>
    <Literal ID="779CCD981D80C839EB6300C0CD56D8CE">
      <Value>Zlecono METAR dla czasow startu i ladowania. Odswiez analize po pobraniu.</Value>
      <Translation Locale="pl-PL">Zlecono METAR dla czasow startu i ladowania. Odswiez analize po pobraniu.</Translation>
      <Translation Locale="en-US">METAR requested for takeoff and landing times. Refresh the analysis after retrieval.</Translation>
      <Translation Locale="de-DE">METAR für Start- und Landezeiten angefordert. Aktualisieren Sie danach die Analyse.</Translation>
      <Translation Locale="es-ES">Se solicitó METAR para las horas de despegue y aterrizaje. Actualice el análisis tras obtenerlo.</Translation>
    </Literal>
    <Literal ID="4387759C823473F6D1B2BB8391A40B80">
      <Value>Map: only explicit coordinates; procedures are not expanded.</Value>
      <Translation Locale="pl-PL">Mapa: tylko jawne współrzędne; procedury nie są rozwijane.</Translation>
      <Translation Locale="en-US">Map: only explicit coordinates; procedures are not expanded.</Translation>
      <Translation Locale="de-DE">Karte: nur explizite Koordinaten; Verfahren werden nicht aufgelöst.</Translation>
      <Translation Locale="es-ES">Mapa: solo coordenadas explícitas; no se desarrollan los procedimientos.</Translation>
    </Literal>
    <Literal ID="781E4FF779360859985BD2F95F4AB687">
      <Value>No saved flight plan for this recording.</Value>
      <Translation Locale="pl-PL">Brak zapisanego planu lotu dla tego nagrania.</Translation>
      <Translation Locale="en-US">No saved flight plan for this recording.</Translation>
      <Translation Locale="de-DE">Kein gespeicherter Flugplan für diese Aufzeichnung.</Translation>
      <Translation Locale="es-ES">No hay plan de vuelo guardado para esta grabación.</Translation>
    </Literal>
    <Literal ID="0C9B325139FC431C5064BCC17B08B9E6">
      <Value>Najpierw zakończ nagrywanie tego lotu.</Value>
      <Translation Locale="pl-PL">Najpierw zakończ nagrywanie tego lotu.</Translation>
      <Translation Locale="en-US">Stop recording this flight first.</Translation>
      <Translation Locale="de-DE">Beenden Sie zuerst die Aufzeichnung dieses Flugs.</Translation>
