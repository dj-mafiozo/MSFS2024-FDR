    <Literal ID="49346EF815C4D5BA6E3E85F0F6605581">
      <Value>Brak zapisanej trasy do sprawdzenia starszego planu SimBrief.</Value>
      <Translation Locale="pl-PL">Brak zapisanej trasy do sprawdzenia starszego planu SimBrief.</Translation>
      <Translation Locale="en-US">No recorded route to validate an older SimBrief plan.</Translation>
      <Translation Locale="de-DE">Keine aufgezeichnete Route zum Prüfen eines älteren SimBrief-Plans.</Translation>
      <Translation Locale="es-ES">No hay ruta grabada para validar un plan anterior de SimBrief.</Translation>
      <Translation Locale="fr-FR">Aucun itinéraire enregistré pour valider un plan SimBrief plus ancien.</Translation>
      <Translation Locale="ru-RU">Нет записанного маршрута для проверки более старого плана SimBrief.</Translation>
      <Translation Locale="tr-TR">Eski bir SimBrief planı için doğrulama için kaydedilen rotası yok.</Translation>
      <Translation Locale="it-IT">Nessun percorso registrato per validare un piano SimBrief più vecchio.</Translation>
      <Translation Locale="pt-PT">Nenhum roteiro registrado para validar um plano SimBrief mais antigo.</Translation>
      <Translation Locale="en-GB">No recorded route to validate an older SimBrief plan.</Translation>
      <Translation Locale="fr-CA">Aucun itinéraire enregistré pour valider un plan SimBrief plus ancien.</Translation>
      <Translation Locale="pt-BR">Nenhum roteiro gravado para validar um plano SimBrief mais antigo.</Translation>
      <Translation Locale="de-AT">Keine aufgezeichnete Route zum Prüfen eines älteren SimBrief-Plans.</Translation>
      <Translation Locale="de-CH">Keine aufgezeichnete Route zum Prüfen eines älteren SimBrief-Plans.</Translation>
      <Translation Locale="be-BY">Няма запісанага шляху для праверкі старога плана SimBrief.</Translation>
      <Translation Locale="el-GR">Δεν υπάρχει καταγραφή δρομικού δρόμου για να επαληθευτεί ένα παλαιό σχέδιο SimBrief.</Translation>
      <Translation Locale="uk-UA">Нема записаного маршруту для перевірки старого плану SimBrief.</Translation>
      <Translation Locale="hr-HR">Nema zapisanog puta za provjeru starijeg plana SimBrief.</Translation>
      <Translation Locale="cs-CZ">Žádný zaznamenaný trasový bod pro ověření staršího plánu SimBrief.</Translation>
      <Translation Locale="da-DK">Ingen registreret rute til at validere en ældre SimBrief-plan.</Translation>
      <Translation Locale="nl-NL">Geen opgenomen route om een oudere SimBrief-plan te valideren.</Translation>
      <Translation Locale="fi-FI">Ei tallennettua reittiä vanhan SimBrief-ohjelman vahvistamiseen.</Translation>
      <Translation Locale="nb-NO">Ingen registrert rute for å validere en eldre SimBrief-plan.</Translation>
      <Translation Locale="sk-SK">Žiadny zaznamenaný štítok na overenie staršieho plánu SimBrief.</Translation>
      <Translation Locale="sv-SE">Ingen registrerad rutt för att validera en äldre SimBrief-plan.</Translation>
      <Translation Locale="zh-CN">无记录的航线以验证旧的SimBrief计划。</Translation>
      <Translation Locale="ja-JP">古いSimBrief計画を検証するための記録されたルートがありません。</Translation>
      <Translation Locale="vi-VN">Không có tuyến đường được ghi lại để xác minh kế hoạch SimBrief cũ.</Translation>
      <Translation Locale="hi-IN">एक पुराने सिमब्रीफ़ योजना के लिए रिकॉर्ड किया गया मार्ग नहीं है।</Translation>
      <Translation Locale="ar-SA">لا يوجد مسار مسجل لتأكيد خطة SimBrief القديمة.</Translation>
      <Translation Locale="he-IL">אין נתיב מוקלט לאימות תוכנית SimBrief ישנה.</Translation>
      <Translation Locale="id-ID">Tidak ada rute yang direkam untuk memvalidasi rencana SimBrief yang lebih lama.</Translation>
    </Literal>
    <Literal ID="6C92188A4FFBC7504206C18BBE8ED085">
      <Value>Niezgodne lotniska zapisanego planu lotu.</Value>
      <Translation Locale="pl-PL">Niezgodne lotniska zapisanego planu lotu.</Translation>
      <Translation Locale="en-US">Recorded flight plan airports do not match.</Translation>
      <Translation Locale="de-DE">Flughäfen des aufgezeichneten Flugplans stimmen nicht überein.</Translation>
      <Translation Locale="es-ES">Los aeropuertos del plan de vuelo grabado no coinciden.</Translation>
      <Translation Locale="fr-FR">Les aéroports du plan de vol enregistré ne correspondent pas.</Translation>
      <Translation Locale="ru-RU">Записанные аэропорты плана полета не совпадают.</Translation>
      <Translation Locale="tr-TR">Kaydedilen uçuş planı havalimanları eşleşmiyor.</Translation>
      <Translation Locale="it-IT">I aeroporti del piano di volo registrati non corrispondono.</Translation>
      <Translation Locale="pt-PT">Os aeroportos do plano de voo gravados não correspondem.</Translation>
      <Translation Locale="en-GB">Recorded flight plan airports do not match.</Translation>
      <Translation Locale="fr-CA">Les aéroports du plan de vol enregistré ne correspondent pas.</Translation>
