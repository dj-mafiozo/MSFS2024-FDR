    <Literal ID="BE55892DEAEA6231EF447224C5B5CF90">
      <Value>Brak daty UTC do potwierdzenia zgodnosci lotu.</Value>
      <Translation Locale="pl-PL">Brak daty UTC do potwierdzenia zgodnosci lotu.</Translation>
      <Translation Locale="en-US">Missing UTC date to verify flight matching.</Translation>
      <Translation Locale="de-DE">UTC-Datum zum Prüfen der Flugübereinstimmung fehlt.</Translation>
      <Translation Locale="es-ES">Falta la fecha UTC para verificar la coincidencia del vuelo.</Translation>
      <Translation Locale="fr-FR">Date UTC manquante pour vérifier la correspondance du vol.</Translation>
      <Translation Locale="ru-RU">Отсутствует дата UTC для проверки соответствия полета.</Translation>
      <Translation Locale="tr-TR">Uçuş eşleşmesi için UTC tarihi eksik.</Translation>
      <Translation Locale="it-IT">Data UTC mancante per verificare la corrispondenza del volo.</Translation>
      <Translation Locale="pt-PT">Data UTC ausente para verificar a correspondência do voo.</Translation>
      <Translation Locale="en-GB">Missing UTC date to verify flight matching.</Translation>
      <Translation Locale="fr-CA">Date UTC manquante pour vérifier la correspondance du vol.</Translation>
      <Translation Locale="pt-BR">Data UTC ausente para verificar correspondência do voo.</Translation>
      <Translation Locale="de-AT">UTC-Datum zum Prüfen der Flugübereinstimmung fehlt.</Translation>
      <Translation Locale="de-CH">UTC-Datum zum Prüfen der Flugübereinstimmung fehlt.</Translation>
      <Translation Locale="be-BY">Няма даты UTC для пераўтварэння падняцця.</Translation>
      <Translation Locale="el-GR">Λείπει η ημερομηνία UTC για την επαλήθευση ταυτοποίησης πτήσης.</Translation>
      <Translation Locale="uk-UA">Відсутній UTC дата для перевірки відповідності польоту.</Translation>
      <Translation Locale="hr-HR">Nema UTC datuma za provjere podudarnosti leta.</Translation>
      <Translation Locale="cs-CZ">Chybí datum UTC pro ověření shody letu.</Translation>
      <Translation Locale="da-DK">Manglende UTC dato til at verificere flymøde.</Translation>
      <Translation Locale="nl-NL">Ontbrekende UTC datum om vlucht te verifiëren.</Translation>
      <Translation Locale="fi-FI">Puuttuva UTC-päivämäärä lentosopimuksen tarkistamiseen.</Translation>
      <Translation Locale="nb-NO">Missing UTC date to verify flight matching.</Translation>
      <Translation Locale="sk-SK">Chýba UTC dátum na overenie príslušnosti letu.</Translation>
      <Translation Locale="sv-SE">Missing UTC datum för att bekräfta flygmatchning.</Translation>
      <Translation Locale="zh-CN">缺失UTC日期以验证飞行匹配。</Translation>
      <Translation Locale="ja-JP">飛行の一致を確認するためのUTC日付が不足しています。</Translation>
      <Translation Locale="vi-VN">Thiếu ngày giờ UTC để xác minh sự phù hợp của chuyến bay.</Translation>
      <Translation Locale="hi-IN">उड़ान तिथि के लिए UTC तारिख गायब है।</Translation>
      <Translation Locale="ar-SA">التاريخ UTC مفقود لتأكيد تطابق الرحلة.</Translation>
      <Translation Locale="he-IL">תאריך UTC חסר כדי לוודא התאמה לטיסה.</Translation>
      <Translation Locale="id-ID">Tanggal UTC Hilang untuk Memverifikasi Kesesuaian Penerbangan.</Translation>
    </Literal>
    <Literal ID="DAD323056BB370706824AA989023E3F4">
      <Value>Termin SimBrief rozni sie od czasu symulatora o ponad 12 godzin.</Value>
      <Translation Locale="pl-PL">Termin SimBrief rozni sie od czasu symulatora o ponad 12 godzin.</Translation>
      <Translation Locale="en-US">SimBrief schedule differs from simulator time by more than 12 hours.</Translation>
      <Translation Locale="de-DE">SimBrief-Zeitplan weicht um mehr als 12 Stunden von der Simulatorzeit ab.</Translation>
      <Translation Locale="es-ES">El horario de SimBrief difiere más de 12 horas de la hora del simulador.</Translation>
      <Translation Locale="fr-FR">L'horaire SimBrief diffère de plus de 12 heures par rapport à l'heure du simulateur.</Translation>
      <Translation Locale="ru-RU">График SimBrief отличается от времени симулятора более чем на 12 часов.</Translation>
      <Translation Locale="tr-TR">SimBrief zamanı simülatör zamanından 12 saatten fazla farklı.</Translation>
      <Translation Locale="it-IT">L'orario SimBrief differisce dal tempo del simulatore di più di 12 ore.</Translation>
      <Translation Locale="pt-PT">O horário do SimBrief difere do tempo do simulador em mais de 12 horas.</Translation>
      <Translation Locale="en-GB">SimBrief schedule differs from simulator time by more than 12 hours.</Translation>
      <Translation Locale="fr-CA">L'horaire SimBrief diffère de plus de 12 heures par rapport à l'heure du simulateur.</Translation>
      <Translation Locale="pt-BR">O agendamento do SimBrief difere do tempo do simulador em mais de 12 horas.</Translation>
      <Translation Locale="de-AT">SimBrief-Zeitplan weicht um mehr als 12 Stunden von der Simulatorzeit ab.</Translation>
      <Translation Locale="de-CH">SimBrief-Zeitplan weicht um mehr als 12 Stunden von der Simulatorzeit ab.</Translation>
      <Translation Locale="be-BY">Час раскладу СімБриф адрозніваецца ад часу сімulatorа больш за 12 гадзін.</Translation>
      <Translation Locale="el-GR">Η ώρα του SimBrief διαφέρει από την ώρα του προσομιουμένου κατά περισσότερα από 12 ώρες.</Translation>
      <Translation Locale="uk-UA">Час графіка SimBrief відрізняється від часу симулятора більше ніж на 12 годин.</Translation>
      <Translation Locale="hr-HR">SimBrief raspored se razlikuje od vremena simulacije više od 12 sati.</Translation>
      <Translation Locale="cs-CZ">Rozdíl mezi plánem SimBrief a časem simulace přesáhne 12 hodin.</Translation>
      <Translation Locale="da-DK">SimBrief schedule forskel fra simulator tid overstiger 12 timer.</Translation>
      <Translation Locale="nl-NL">SimBrief planning verschilt meer dan 12 uur van de simulatietijd.</Translation>
      <Translation Locale="fi-FI">SimBrief-jakso eroaa simulaattorin ajasta yli 12 tuntia.</Translation>
      <Translation Locale="nb-NO">SimBrief-skjema avviker mer enn 12 timer fra simulator-tid.</Translation>
      <Translation Locale="sk-SK">Plán SimBrief sa líši od simulátorového času viac než o 12 hodín.</Translation>
      <Translation Locale="sv-SE">SimBriefs schemat skiljer sig från simulator_tid med mer än 12 timmar.</Translation>
      <Translation Locale="zh-CN">SimBrief 安排时间与模拟器时间相差超过 12 小时。</Translation>
      <Translation Locale="ja-JP">SimBrief のスケジュールはシミュレータ時間と12時間以上異なります。</Translation>
      <Translation Locale="vi-VN">Thời gian lịch trình SimBrief khác với thời gian mô phỏng hơn 12 giờ.</Translation>
      <Translation Locale="hi-IN">सिमब्रीफ शेड्यूल सिमुलेटर समय से 12 घंटे से अधिक अलग है।</Translation>
      <Translation Locale="ar-SA">يختلف جدول سيمبريف عن وقت المحاكاة بأكثر من 12 ساعة.</Translation>
      <Translation Locale="he-IL">לוח הזמנים של SimBrief שונה משעת הסימולטור ביותר מ־12 שעות.</Translation>
      <Translation Locale="id-ID">Jadwal SimBrief berbeda dari waktu simulator lebih dari 12 jam.</Translation>
    </Literal>
