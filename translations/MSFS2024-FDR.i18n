    <Literal ID="BE55892DEAEA6231EF447224C5B5CF90">
      <Value>Brak daty UTC do potwierdzenia zgodnosci lotu.</Value>
      <Translation Locale="pl-PL">Brak daty UTC do potwierdzenia zgodnosci lotu.</Translation>
      <Translation Locale="en-US">Missing UTC date to verify flight matching.</Translation>
      <Translation Locale="de-DE">UTC-Datum zum Prüfen der Flugübereinstimmung fehlt.</Translation>
      <Translation Locale="es-ES">Falta la fecha UTC para verificar la coincidencia del vuelo.</Translation>
    </Literal>
    <Literal ID="DAD323056BB370706824AA989023E3F4">
      <Value>Termin SimBrief rozni sie od czasu symulatora o ponad 12 godzin.</Value>
      <Translation Locale="pl-PL">Termin SimBrief rozni sie od czasu symulatora o ponad 12 godzin.</Translation>
      <Translation Locale="en-US">SimBrief schedule differs from simulator time by more than 12 hours.</Translation>
      <Translation Locale="de-DE">SimBrief-Zeitplan weicht um mehr als 12 Stunden von der Simulatorzeit ab.</Translation>
      <Translation Locale="es-ES">El horario de SimBrief difiere más de 12 horas de la hora del simulador.</Translation>
    </Literal>
    <Literal ID="AC45D56299DF5687F925B27A5A1A8900">
