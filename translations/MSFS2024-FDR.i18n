      <Translation Locale="pl-PL">Inny numer lotu.</Translation>
      <Translation Locale="en-US">Flight number does not match.</Translation>
      <Translation Locale="de-DE">Flugnummer stimmt nicht überein.</Translation>
      <Translation Locale="es-ES">El número de vuelo no coincide.</Translation>
    </Literal>
    <Literal ID="E4DCA6AE8E60E233C642734FF327DB03">
      <Value>Inna rejestracja samolotu.</Value>
      <Translation Locale="pl-PL">Inna rejestracja samolotu.</Translation>
      <Translation Locale="en-US">Aircraft registration does not match.</Translation>
      <Translation Locale="de-DE">Flugzeugregistrierung stimmt nicht überein.</Translation>
      <Translation Locale="es-ES">La matrícula del avión no coincide.</Translation>
    </Literal>
    <Literal ID="74B9111393C07F435C23B1FF1841FFBE">
