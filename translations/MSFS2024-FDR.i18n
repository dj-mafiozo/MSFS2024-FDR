      <Translation Locale="el-GR">Η καταγραφή δεν βρέθηκε.</Translation>
      <Translation Locale="uk-UA">Запис не знайдено.</Translation>
      <Translation Locale="hr-HR">Snimanje nije pronađeno.</Translation>
      <Translation Locale="cs-CZ">Záznam nenalezen.</Translation>
      <Translation Locale="da-DK">Opntag ikke fundet.</Translation>
      <Translation Locale="nl-NL">Opname niet gevonden.</Translation>
      <Translation Locale="fi-FI">Tallennusta ei löytynyt.</Translation>
      <Translation Locale="nb-NO">Innspilling ikke funnet.</Translation>
      <Translation Locale="sk-SK">Záznam nebol nájdený.</Translation>
      <Translation Locale="sv-SE">Insammanställning hittades inte.</Translation>
      <Translation Locale="zh-CN">录音未找到。</Translation>
      <Translation Locale="ja-JP">録音が見つかりません。</Translation>
      <Translation Locale="vi-VN">Không tìm thấy ghi âm.</Translation>
      <Translation Locale="hi-IN">रिकॉर्डिंग नहीं मिला।</Translation>
      <Translation Locale="ar-SA">لم يتم العثور على تسجيل.</Translation>
