    <Literal ID="EDB5F90FB1215DE8CF8A61CD256DA85F">
      <Value>Brak zdarzen z rozpoznanym ICAO i poprawnym czasem UTC.</Value>
      <Translation Locale="pl-PL">Brak zdarzen z rozpoznanym ICAO i poprawnym czasem UTC.</Translation>
      <Translation Locale="en-US">No events with a recognized ICAO and valid UTC time.</Translation>
      <Translation Locale="de-DE">Keine Ereignisse mit erkanntem ICAO und gültiger UTC-Zeit.</Translation>
      <Translation Locale="es-ES">No hay eventos con ICAO reconocido y hora UTC válida.</Translation>
      <Translation Locale="fr-FR">Aucun événement avec un ICAO reconnu et une heure UTC valide.</Translation>
      <Translation Locale="ru-RU">Нет событий с распознанным ICAO и действительным UTC времени.</Translation>
      <Translation Locale="tr-TR">Tanımlanmış ICAO ve geçerli UTC zamanı olan olay yok.</Translation>
      <Translation Locale="it-IT">Nessun evento con ICAO riconosciuto e ora UTC valida.</Translation>
      <Translation Locale="pt-PT">Nenhum evento com ICAO reconhecido e hora UTC válida.</Translation>
      <Translation Locale="en-GB">No events with a recognized ICAO and valid UTC time.</Translation>
      <Translation Locale="fr-CA">Aucun événement avec un ICAO reconnu et une heure UTC valide.</Translation>
      <Translation Locale="pt-BR">Nenhuma evento com um ICAO reconhecido e horário UTC válido.</Translation>
      <Translation Locale="de-AT">Keine Ereignisse mit erkanntem ICAO und gültiger UTC-Zeit.</Translation>
      <Translation Locale="de-CH">Keine Ereignisse mit erkanntem ICAO und gültiger UTC-Zeit.</Translation>
      <Translation Locale="be-BY">Няма падзеяў з падтрыманым ICAO і дадзеным UTC часам.</Translation>
      <Translation Locale="el-GR">Δεν υπάρχουν γεγονότα με αναγνωρισμένο ICAO και έγκυρο ώρα UTC.</Translation>
      <Translation Locale="uk-UA">Нема подій з визнаним ICAO та дійсним UTC часом.</Translation>
      <Translation Locale="hr-HR">Nema događaja s prepoznatim ICAO i valjanim UTC vremenom.</Translation>
      <Translation Locale="cs-CZ">Žádné události s poznávaným ICAO a platným časem UTC.</Translation>
      <Translation Locale="da-DK">Ingen begivenheder med genkendt ICAO og gyldig UTC-tid.</Translation>
      <Translation Locale="nl-NL">Geen gebeurtenissen met een herkenbare ICAO en geldige UTC-tijd.</Translation>
      <Translation Locale="fi-FI">Ei tapahtumia tunnistetulla ICAO:lla ja päällä olevalla UTC-aikalla.</Translation>
      <Translation Locale="nb-NO">Ingen hendelser med en kjent ICAO og gyldig UTC-tid.</Translation>
      <Translation Locale="sk-SK">Žiadne udalosti s rozpoznaným ICAO a platným UTC časom.</Translation>
      <Translation Locale="sv-SE">Ingen händelser med ett igenkännbart ICAO och giltig UTC-tid.</Translation>
      <Translation Locale="zh-CN">没有具有已识别ICAO和有效UTC时间的事件。</Translation>
      <Translation Locale="ja-JP">認識可能なICAOと有効なUTC時間を持つイベントはありません。</Translation>
      <Translation Locale="vi-VN">Không có sự kiện nào có mã ICAO được nhận diện và thời gian UTC hợp lệ.</Translation>
      <Translation Locale="hi-IN">मान्य ICAO और वैध UTC समय वाले घटनाओं के लिए कोई आवेदन नहीं है।</Translation>
      <Translation Locale="ar-SA">لا توجد أحداث تُعرف بICAو ووقت UTC صحيح.</Translation>
      <Translation Locale="he-IL">אין אירועים עם ICAO מוכרים וזמן UTC תקף.</Translation>
      <Translation Locale="id-ID">Tidak ada peristiwa dengan ICAO yang dikenal dan waktu UTC yang valid.</Translation>
    </Literal>
    <Literal ID="DBFE6EB5504DC42CF000CA79517F164B">
      <Value>Brak zarejestrowanego kontaktu z pasem dla tego lotu.</Value>
      <Translation Locale="pl-PL">Brak zarejestrowanego kontaktu z pasem dla tego lotu.</Translation>
      <Translation Locale="en-US">No recorded runway contact for this flight.</Translation>
      <Translation Locale="de-DE">Kein Pistenkontakt für diesen Flug aufgezeichnet.</Translation>
      <Translation Locale="es-ES">No hay contacto con la pista registrado para este vuelo.</Translation>
      <Translation Locale="fr-FR">Aucun contact avec la piste enregistré pour ce vol.</Translation>
      <Translation Locale="ru-RU">Нет записанного контакта с полосой для этого полета.</Translation>
      <Translation Locale="tr-TR">Bu uçuş için kaydedilen piste teması yok.</Translation>
      <Translation Locale="it-IT">Nessun contatto con la pista registrato per questo volo.</Translation>
      <Translation Locale="pt-PT">Nenhum contato com a pista registrado para este voo.</Translation>
      <Translation Locale="en-GB">No recorded runway contact for this flight.</Translation>
      <Translation Locale="fr-CA">Aucun contact avec la piste enregistré pour ce vol.</Translation>
      <Translation Locale="pt-BR">Nenhum contato com a pista registrada para esta viagem.</Translation>
      <Translation Locale="de-AT">Kein Pistenkontakt für diesen Flug aufgezeichnet.</Translation>
      <Translation Locale="de-CH">Kein Pistenkontakt für diesen Flug aufgezeichnet.</Translation>
      <Translation Locale="be-BY">Няма запісанага злучэння з падштыццем для гэтага пад'яўніка.</Translation>
      <Translation Locale="el-GR">Δεν υπάρχει καταγεγραμμένη επαφή με τον απογειωτή για αυτήν την πτήση.</Translation>
      <Translation Locale="uk-UA">Нема записаного з'єднання з під'їздом для цього політu.</Translation>
      <Translation Locale="hr-HR">Nema zapisanog kontaktiranja s piste za ovaj let.</Translation>
      <Translation Locale="cs-CZ">Žádný zaznamenaný kontakt s plochou pro tento let.</Translation>
      <Translation Locale="da-DK">Ingen registreret kontakt med startbane for denne flyvning.</Translation>
      <Translation Locale="nl-NL">Geen opgenomen contact met een startbaan voor deze vlucht.</Translation>
      <Translation Locale="fi-FI">Ei tallennettua lähtöbaanin kosketusta lentotietueelle.</Translation>
      <Translation Locale="nb-NO">Ingen registrert startbane kontakt for denne flytten.</Translation>
      <Translation Locale="sk-SK">Žiadny zaznamenaný kontakt s prievoznou dráhou pre túto leteckú záležitosť.</Translation>
      <Translation Locale="sv-SE">Innen registrerad startbana kontakt för denna flygning.</Translation>
      <Translation Locale="zh-CN">此航班未记录跑道接触。</Translation>
      <Translation Locale="ja-JP">この飛行のランウェイ接触が記録されていません。</Translation>
      <Translation Locale="vi-VN">Không có tiếp xúc với đường băng được ghi lại cho chuyến bay này.</Translation>
      <Translation Locale="hi-IN">इस उड़ान के लिए रिकॉर्ड किया गया रनवे संपर्क नहीं है।</Translation>
      <Translation Locale="ar-SA">لا يوجد اتصال بالرungs المسجل لهذا الرحلة.</Translation>
      <Translation Locale="he-IL">אין התקשרות עם הרצועה המורכבת עבור הטיסה הזו.</Translation>
      <Translation Locale="id-ID">Tidak ada kontak landasan pacu yang direkam untuk penerbangan ini.</Translation>
    </Literal>
