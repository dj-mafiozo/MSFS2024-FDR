  <Domain Name="Application">
    <Literal ID="43AA53F86C4AF72B0F9810C25D4A1EE7">
      <Value>Nieprawidlowy czas UTC zdarzenia: </Value>
      <Translation Locale="pl-PL">Nieprawidlowy czas UTC zdarzenia: </Translation>
      <Translation Locale="en-US">Invalid event UTC time: </Translation>
      <Translation Locale="de-DE">Ungültige UTC-Ereigniszeit: </Translation>
      <Translation Locale="es-ES">Hora UTC del evento no válida: </Translation>
    </Literal>
    <Literal ID="B7246C7C1CA5350CADBCADCFAC0B9A98">
      <Value>Za duzo probek analizy (&gt;6000). Zmniejsz okno czasowe w ustawieniach AI.</Value>
      <Translation Locale="pl-PL">Za duzo probek analizy (&gt;6000). Zmniejsz okno czasowe w ustawieniach AI.</Translation>
      <Translation Locale="en-US">Too many analysis samples (&gt;6000). Reduce the analysis time window in Settings.</Translation>
      <Translation Locale="de-DE">Zu viele Analysewerte (&gt;6000). Verkleinern Sie das Analysezeitfenster in den Einstellungen.</Translation>
      <Translation Locale="es-ES">Demasiadas muestras de análisis (&gt;6000). Reduzca el intervalo de análisis en Ajustes.</Translation>
    </Literal>
    <Literal ID="0711F81995839FBA4D49527A1E667C7F">
      <Value>Nie znaleziono Codex: </Value>
      <Translation Locale="pl-PL">Nie znaleziono Codex: </Translation>
      <Translation Locale="en-US">Codex not found: </Translation>
      <Translation Locale="de-DE">Codex nicht gefunden: </Translation>
      <Translation Locale="es-ES">No se encontró Codex: </Translation>
    </Literal>
    <Literal ID="8B9FC0A1C7B8AF0A0B5672D0E445C174">
      <Value>Wybierz natywny plik codex.exe (nie skrypt .cmd lub .ps1).</Value>
      <Translation Locale="pl-PL">Wybierz natywny plik codex.exe (nie skrypt .cmd lub .ps1).</Translation>
      <Translation Locale="en-US">Select the native codex.exe executable (not a .cmd or .ps1 script).</Translation>
      <Translation Locale="de-DE">Wählen Sie die ausführbare Datei codex.exe (kein .cmd- oder .ps1-Skript).</Translation>
      <Translation Locale="es-ES">Seleccione el ejecutable codex.exe (no un script .cmd o .ps1).</Translation>
    </Literal>
    <Literal ID="1522A69034D77C7D226657246D182C94">
      <Value>Nie znaleziono Codex CLI. Zainstaluj go i wykonaj codex login lub ustaw sciezke w ustawieniach AI.</Value>
      <Translation Locale="pl-PL">Nie znaleziono Codex CLI. Zainstaluj go i wykonaj codex login lub ustaw sciezke w ustawieniach AI.</Translation>
      <Translation Locale="en-US">Codex CLI not found. Install it and run codex login, or set its path in Settings.</Translation>
      <Translation Locale="de-DE">Codex CLI nicht gefunden. Installieren Sie es und führen Sie codex login aus oder geben Sie den Pfad in den Einstellungen an.</Translation>
      <Translation Locale="es-ES">No se encontró Codex CLI. Instálelo y ejecute codex login, o indique su ruta en Ajustes.</Translation>
    </Literal>
