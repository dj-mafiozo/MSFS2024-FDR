      <Translation Locale="pl-PL">Inna linia lotnicza.</Translation>
      <Translation Locale="en-US">Airline does not match.</Translation>
      <Translation Locale="de-DE">Fluggesellschaft stimmt nicht überein.</Translation>
      <Translation Locale="es-ES">La aerolínea no coincide.</Translation>
    </Literal>
    <Literal ID="6008292409229A85F6FC486EF39FDBF5">
