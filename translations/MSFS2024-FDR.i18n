    <Literal ID="E988B44D2A8DB16D5FE0FB6A443EA5A3">
      <Value>Przekroczono limit czasu analizy Codex.</Value>
      <Translation Locale="pl-PL">Przekroczono limit czasu analizy Codex.</Translation>
      <Translation Locale="en-US">Codex analysis timed out.</Translation>
      <Translation Locale="de-DE">Zeitüberschreitung bei der Codex-Analyse.</Translation>
      <Translation Locale="es-ES">Se agotó el tiempo de análisis de Codex.</Translation>
      <Translation Locale="fr-FR">Le traitement d'analyse de Codex a expiré.</Translation>
      <Translation Locale="ru-RU">Время анализа Codex истекло.</Translation>
      <Translation Locale="tr-TR">Codex analizi zaman aşımına uğradı.</Translation>
      <Translation Locale="it-IT">Il processo di analisi di Codex è scaduto.</Translation>
      <Translation Locale="pt-PT">O processamento de análise do Codex expirou.</Translation>
      <Translation Locale="en-GB">Codex analysis timed out.</Translation>
      <Translation Locale="fr-CA">Le traitement d'analyse de Codex a expiré.</Translation>
      <Translation Locale="pt-BR">Kodex expirou o tempo de análise.</Translation>
      <Translation Locale="de-AT">Zeitüberschreitung bei der Codex-Analyse.</Translation>
      <Translation Locale="de-CH">Zeitüberschreitung bei der Codex-Analyse.</Translation>
      <Translation Locale="be-BY">Кодекс завершыўся часам аналізу.</Translation>
