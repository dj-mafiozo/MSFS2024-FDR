      <Translation Locale="de-CH">Umschalt+Klick: neuen Bericht auf Polnisch erstellen</Translation>
      <Translation Locale="be-BY">Shift+click: генеруйце новы звіт на польскай мове</Translation>
      <Translation Locale="el-GR">Shift+click: δημιουργήστε ένα νέο έγγραφο στα πολωνικά</Translation>
      <Translation Locale="uk-UA">Shift+click: створити новий звіт на польській мові</Translation>
      <Translation Locale="hr-HR">Shift+click: generiraj novi izvještaj na polski</Translation>
      <Translation Locale="cs-CZ">Shift+klepnutí: vygenerovat nový zprávu na polský</Translation>
      <Translation Locale="da-DK">Shift+click: generér en ny report på polsk</Translation>
      <Translation Locale="nl-NL">Shift+click: een nieuw rapport genereren in Pools</Translation>
      <Translation Locale="fi-FI">Shift+click: luodaan uusi raportti suomeksi</Translation>
      <Translation Locale="nb-NO">Shift+click: generer en ny rapport på norsk</Translation>
      <Translation Locale="sk-SK">Shift+klepnutie: vytvoriť nový správu v poľskom jazyku</Translation>
      <Translation Locale="sv-SE">Shift+klicka: generera en ny rapport på polska</Translation>
      <Translation Locale="zh-CN">Shift+单击：生成波兰语的新报告</Translation>
      <Translation Locale="ja-JP">Shift＋クリック：ポーランド語の新しいレポートを生成</Translation>
      <Translation Locale="vi-VN">Nhấn Shift + click: tạo báo cáo mới bằng tiếng Ba Lan</Translation>
      <Translation Locale="hi-IN">Shift+click: एक नया पोलैंड रिपोर्ट बनाएं</Translation>
      <Translation Locale="ar-SA">الضغط + النقر: إنشاء تقرير جديد باللغة البولندية</Translation>
      <Translation Locale="he-IL">החלקה + לחיצה: יוצר דוח חדש בפולין</Translation>
