    <Literal ID="1E23D27DE2EE65FFF617ACF4A72D4991">
      <Value>. Sprawdz codex login i dostepne limity.</Value>
      <Translation Locale="pl-PL">. Sprawdz codex login i dostepne limity.</Translation>
      <Translation Locale="en-US">. Check codex login and your available usage limits.</Translation>
