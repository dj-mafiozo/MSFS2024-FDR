      <Translation Locale="en-US">Shift+click: generate a new report in Polish</Translation>
      <Translation Locale="de-DE">Umschalt+Klick: neuen Bericht auf Polnisch erstellen</Translation>
      <Translation Locale="es-ES">Mayús+clic: generar un nuevo informe en polaco</Translation>
      <Translation Locale="fr-FR">Shift+click : générer un nouveau rapport en polonais</Translation>
      <Translation Locale="ru-RU">Shift+клик: создать новый отчет на польском языке</Translation>
      <Translation Locale="tr-TR">Shift+click: Polonya dilinde yeni bir rapor oluştur</Translation>
      <Translation Locale="it-IT">Shift+click: genera un nuovo rapporto in polacco</Translation>
      <Translation Locale="pt-PT">Shift+click: gerar um novo relatório em polonês</Translation>
      <Translation Locale="en-GB">Shift+click: generate a new report in Polish</Translation>
