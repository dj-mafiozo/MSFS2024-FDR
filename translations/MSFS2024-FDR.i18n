    <Literal ID="AC5EDA99CB16634186613D489653CCE8">
      <Value>Codex EXE (puste = wykryj automatycznie)</Value>
      <Translation Locale="pl-PL">Codex EXE (puste = wykryj automatycznie)</Translation>
      <Translation Locale="en-US">Codex EXE (empty = auto-detect)</Translation>
      <Translation Locale="de-DE">Codex-EXE (leer = automatisch erkennen)</Translation>
      <Translation Locale="es-ES">EXE de Codex (vacío = detectar automáticamente)</Translation>
      <Translation Locale="fr-FR">Codex EXE (vide = détection automatique)</Translation>
      <Translation Locale="ru-RU">Codex EXE (пусто = автоматическое определение)</Translation>
